venv/
.venv/
__pycache__/
*.pyc
.DS_Store
.env
.env.local

# Datos — demasiado pesados o generados (no reproducibles en git).
# Quien clona el repo restaura la BD desde el dump (ver README), no scrapea.
data/*
!data/.gitkeep

# Dump de la BD distribuible (se descarga del Drive, ver README).
db/seed/*
!db/seed/.gitkeep

# Artefactos de indexado + caché
*.npy
*.pkl
*.pkl.tmp

# Resultados de evaluación (regenerables con eval/benchmark.py)
eval/results/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
